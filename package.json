{
  "name": "contenthub",
  "version": "1.0.0",
  "private": true,
  "description": "ContentHub: a three-service NestJS and MongoDB portfolio backend",
  "engines": { "node": ">=22" },
  "workspaces": [
    "libs/common",
    "tools/mock-oauth",
    "apps/auth-service",
    "apps/profile-service",
    "apps/catalog-service"
  ],
  "scripts": {
    "build": "npm run build -w @contenthub/common && npm run build -w @contenthub/mock-oauth -w @contenthub/auth-service -w @contenthub/profile-service -w @contenthub/catalog-service",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "seed": "tsx scripts/seed.ts",
    "start:mock-oauth": "node --env-file=.env tools/mock-oauth/dist/main.js",
    "start:auth": "node --env-file=.env apps/auth-service/dist/main.js",
    "start:profile": "node --env-file=.env apps/profile-service/dist/main.js",
    "start:catalog": "node --env-file=.env apps/catalog-service/dist/main.js"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
