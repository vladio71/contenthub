# Copy to .env:  cp .env.example .env
# Used by the "run locally" commands (npm run start:*, npm run seed, npm run test:e2e).
# docker compose reads JWT_SECRET from here too, and ignores the rest.

# ---- shared by all services ----
# Secret for signing and checking access tokens (HS256). At least 32 characters.
# In production use asymmetric keys (RS256 or EdDSA) so only auth-service can sign.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# MongoDB replica set. Transactions need a replica set.
# From your machine, with `docker compose up -d --wait mongo`, "directConnection=true" is needed because
# the replica set announces itself as "mongo:27017", a name that only exists inside docker.
MONGO_URI=mongodb://localhost:27017/?directConnection=true

# Optional. Defaults: auth-service 4001, profile-service 4002, catalog-service 4003.
# Each service has its own database name. Defaults: contenthub_auth, contenthub_profiles, contenthub_catalog.
# PORT=
# MONGO_DB_NAME=

# ---- auth-service ----
# Defaults point to tools/mock-oauth (npm run start:mock-oauth). No secrets needed.
GITHUB_CLIENT_ID=mock-client-id
GITHUB_CLIENT_SECRET=mock-client-secret
GITHUB_AUTHORIZE_URL=http://localhost:9000/authorize
GITHUB_TOKEN_URL=http://localhost:9000/access_token
GITHUB_API_URL=http://localhost:9000
# Where the provider sends the user back. For local runs without the gateway use port 4001.
GITHUB_REDIRECT_URI=http://localhost:4001/api/auth/github/callback

# Real GitHub instead of the mock:
# GITHUB_CLIENT_ID=<your oauth app client id>
# GITHUB_CLIENT_SECRET=<your oauth app client secret>
# GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_URL=https://api.github.com

# Lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true when the service is served over HTTPS
COOKIE_SECURE=false

# ---- profile-service ----
AVATAR_DIR=./data/avatars

# ---- mock-oauth ----
MOCK_OAUTH_PORT=9000
